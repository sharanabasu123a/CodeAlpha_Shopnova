# Copy this file to .env and replace the values with your real credentials.
# NEVER commit your real .env file.

# MongoDB connection string (Atlas or local). If omitted, the server falls back
# to an in-memory MongoDB (mongodb-memory-server) seeded with sample data.
MONGO_URI=

# JWT secret used to sign/verify session tokens (7-day expiry)
JWT_SECRET=change_me_to_a_long_random_string

# Port the API listens on
PORT=5000

# Comma-separated list of allowed origins for CORS (the deployed frontend URL).
# localhost is always allowed in development.
CLIENT_ORIGIN=http://localhost:5173

# --- Optional: Cloudinary (only used for admin image uploads) -------------
# If omitted, product images are served from the frontend /public or backend /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to "true" to force seeding on startup (useful for fresh deployments)
SEED_ON_START=false