# Copy to frontend/.env.local for local overrides (optional).
# In development the Vite dev server proxies /api to the backend on port 5000,
# so no value is required to run locally.
VITE_API_URL=

# Only needed when the API is NOT reachable via the Vite proxy (e.g. a deployed backend).
# VITE_API_URL=https://your-backend.onrender.com